{{ ansible_managed | comment }}
# gunicorn configuration for the Superset web workers.

bind = "{{ superset_bind.host }}:{{ superset_bind.port }}"
workers = {{ superset_gunicorn.workers }}
worker_class = "{{ superset_gunicorn.worker_class }}"
worker_connections = {{ superset_gunicorn.worker_connections }}
timeout = {{ superset_gunicorn.timeout }}
keepalive = {{ superset_gunicorn.keepalive }}
limit_request_line = {{ superset_gunicorn.limit_request_line }}
limit_request_field_size = {{ superset_gunicorn.limit_request_field_size }}
graceful_timeout = {{ superset_gunicorn.timeout }}
max_requests = 5000
max_requests_jitter = 500
forwarded_allow_ips = "*"
accesslog = "{{ superset_dir.log }}/gunicorn-access.log"
errorlog = "{{ superset_dir.log }}/gunicorn-error.log"
loglevel = "info"
preload_app = False
